flowchart TD
  S[/"for each incident report (2)<br/>id RSK-0001, RSK-0002"/]:::state
  S --> C(["client.SystemOne"]):::sdk
  C -. "request error" .-> E1("Print error, skip to next incident"):::fail
  C --> Q1["risk_type · Choice<br/>security · operational · financial · compliance"]:::choice
  C --> Q2["severity · Score<br/>low · medium · high · critical"]:::score
  C --> Q3["control_failure · Noul"]:::noul
  C --> Q4["recurrence_likely · Noul"]:::noul
  Q2 --> P1{"severity band"}:::policy
