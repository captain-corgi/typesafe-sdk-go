flowchart TD
  S[/"for each claim + cited passage (2)"/]:::state
  S --> C(["client.SystemOne"]):::sdk
  C --> Q1["supported · Noul"]:::noul
  C --> Q2["support_strength · Score<br/>contradicts · unrelated · weak · direct"]:::score
  C --> Q3["overstates · Noul"]:::noul
